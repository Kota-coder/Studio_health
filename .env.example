# Copy to .env (or .env.local) and fill in. Never commit real values.

# Supabase project (Project Settings -> API). The URL and anon key are public by
# design; row level security protects the data.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server only: used by /api/staff to create staff logins. Keep secret.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google Gemini API key used by the ID-card scan on the registration page
# (src/ai/flows/extract-patient-details.ts) to read name, DOB, address and ID number.
# Server only. Get one at https://aistudio.google.com/apikey
GOOGLE_GENAI_API_KEY=
# Optional: Gemini model id (default gemini-3.5-flash)
# GEMINI_MODEL=gemini-3.5-flash
